<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le thème de Fern Launcher n'est lisible que par les applis signées avec la même clé
         (Fern Launcher, Fern Messages, Fern Contact). Déclarée dans les trois applis : celle
         qui est installée en premier la crée, les autres la partagent. -->
    <permission
        android:name="com.atelierjlg.fern.permission.READ_THEME"
        android:label="Lire le thème de Fern"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.atelierjlg.fern.permission.READ_THEME" />

    <!-- Le dernier code de vérification reçu par Fern Messages, lisible par Fern Clavier. -->
    <permission
        android:name="com.atelierjlg.fern.permission.READ_CODES"
        android:label="Lire les codes de vérification de Fern Messages"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.atelierjlg.fern.permission.READ_CODES" />

    <!-- Depuis Android 11, il faut déclarer les applis qu'on veut « voir ». -->
    <queries>
        <package android:name="com.atelierjlg.fern" />
    </queries>
</manifest>
